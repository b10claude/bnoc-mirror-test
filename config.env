# The one file you need to edit. Every line is KEY=VALUE; the nightly
# workflow reads it, and so does the Makefile when you run things locally.

# The Discourse site to archive.
DISCOURSE_URL=https://bnoc.xyz

# Where the rendered mirror is published, used for the og:url tags in its
# pages. Leave it empty to use this repository's GitHub Pages URL, which is
# what you want unless you serve the mirror from your own domain.
SITE_URL=

# Day of the month on which the nightly sync re-fetches every post instead of
# only the ones created since the last sync. A full sync repairs gaps left by
# posts that were unlisted or missed earlier, at the cost of walking the whole
# site. Use 1-28, or 0 to never do one.
FULL_SYNC_DAY=1

# Archive the images uploaded to the forum and serve them from the mirror, so
# that it keeps its illustrations when the forum is gone. This is the point of
# the exercise and it is on by default; the images are most of the archive's
# size. Set it to an empty value to skip them, which leaves the mirror loading
# them from the forum for as long as the forum is up.
ARCHIVE_IMAGES=1

# The archiver to run: a GitHub repository holding archive.py and mirror.py,
# and the git ref to check out. Pin the ref to a tag or commit if you would
# rather decide for yourself when the archiver changes under you.
ARCHIVER_REPO=0xB10C/discourse-archive
ARCHIVER_REF=master

# Typeset the TeX in posts with KaTeX, which the mirror copies into the site so
# it stays self-contained. Set it to an empty value to leave TeX as written.
# Needs an archiver that has mirror.py's --katex flag.
MIRROR_KATEX=1
